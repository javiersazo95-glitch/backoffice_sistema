# Copia este fichero a backoffice/.env y rellena los valores antes de levantar docker-compose.
# .env esta ignorado por git (ver backoffice/.gitignore): nunca lo subas.

# Base de datos de desarrollo
DB_NAME=backoffice_dev
DB_USERNAME=backoffice_dev
DB_PASSWORD=
DB_PORT=5432

# Panel pgAdmin (se publica en http://localhost:5050)
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Puerto del frontend de desarrollo
FRONTEND_PORT=5173
